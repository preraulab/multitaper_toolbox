# CompilerName=mingw64
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/win64
matlabdir = C:/Program Files/MATLAB/R2020b
startdir = C:/Users/mrlon/Dropbox (Personal)/Mac_Desktop/MIT_HST/NSRL_Purdon_Prerau/Prerau_labcode/multitaper/multitaper_spectrogram_mex

# Toolchain information
cc = C:\ProgramData\MATLAB\SupportPackages\R2020b\3P.instrset\mingw_w64.instrset\bin\gcc
cxx = C:\ProgramData\MATLAB\SupportPackages\R2020b\3P.instrset\mingw_w64.instrset\bin\g++
linker = C:\ProgramData\MATLAB\SupportPackages\R2020b\3P.instrset\mingw_w64.instrset\bin\gcc
linkerxx = C:\ProgramData\MATLAB\SupportPackages\R2020b\3P.instrset\mingw_w64.instrset\bin\g++

cflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c99 -I "C:\Users\mrlon\Dropbox (Personal)\Mac_Desktop\MIT_HST\NSRL_Purdon_Prerau\Prerau_labcode\multitaper\multitaper_spectrogram_mex\codegen\mex\multitaper_spectrogram_coder" -I "C:\Users\mrlon\Dropbox (Personal)\Mac_Desktop\MIT_HST\NSRL_Purdon_Prerau\Prerau_labcode\multitaper\multitaper_spectrogram_mex" -I "C:\Users\mrlon\Dropbox (Personal)\Mac_Desktop\MIT_HST\NSRL_Purdon_Prerau\Prerau_labcode\multitaper\multitaper_spectrogram_mex\codegen\mex\multitaper_spectrogram_coder\interface" -I "C:\Program Files\MATLAB\R2020b\extern\include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=multitaper_spectrogram_coder_mex -D__USE_MINGW_ANSI_STDIO=1 -fopenmp 

cxxflags =  -c -fexceptions -fno-omit-frame-pointer -std=c++11 -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c++11 -I "C:\Users\mrlon\Dropbox (Personal)\Mac_Desktop\MIT_HST\NSRL_Purdon_Prerau\Prerau_labcode\multitaper\multitaper_spectrogram_mex\codegen\mex\multitaper_spectrogram_coder" -I "C:\Users\mrlon\Dropbox (Personal)\Mac_Desktop\MIT_HST\NSRL_Purdon_Prerau\Prerau_labcode\multitaper\multitaper_spectrogram_mex" -I "C:\Users\mrlon\Dropbox (Personal)\Mac_Desktop\MIT_HST\NSRL_Purdon_Prerau\Prerau_labcode\multitaper\multitaper_spectrogram_mex\codegen\mex\multitaper_spectrogram_coder\interface" -I "C:\Program Files\MATLAB\R2020b\extern\include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=multitaper_spectrogram_coder_mex -D__USE_MINGW_ANSI_STDIO=1 -fopenmp 

ldflags =  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2020b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -o "multitaper_spectrogram_coder_mex.mexw64" -L"$matlabdir\extern\lib\win64\mingw64" -llibmwlapack -llibmwblas -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp -Wl,--version-script,multitaper_spectrogram_coder_mex.map

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker @$out.rsp $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $ldflags

# Build
build $builddir/multitaper_spectrogram_coder_data.o : cc $root/multitaper_spectrogram_coder_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/multitaper_spectrogram_coder_initialize.o : cc $root/multitaper_spectrogram_coder_initialize.c
build $builddir/multitaper_spectrogram_coder_terminate.o : cc $root/multitaper_spectrogram_coder_terminate.c
build $builddir/multitaper_spectrogram_coder.o : cc $root/multitaper_spectrogram_coder.c
build $builddir/colon.o : cc $root/colon.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/nextpow2.o : cc $root/nextpow2.c
build $builddir/combineVectorElements.o : cc $root/combineVectorElements.c
build $builddir/indexShapeCheck.o : cc $root/indexShapeCheck.c
build $builddir/all.o : cc $root/all.c
build $builddir/any.o : cc $root/any.c
build $builddir/detrend.o : cc $root/detrend.c
build $builddir/qr.o : cc $root/qr.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/repmat.o : cc $root/repmat.c
build $builddir/fft.o : cc $root/fft.c
build $builddir/power.o : cc $root/power.c
build $builddir/eml_mtimes_helper.o : cc $root/eml_mtimes_helper.c
build $builddir/mtimes.o : cc $root/mtimes.c
build $builddir/mean.o : cc $root/mean.c
build $builddir/sum.o : cc $root/sum.c
build $builddir/find.o : cc $root/find.c
build $builddir/eml_setop.o : cc $root/eml_setop.c
build $builddir/issorted.o : cc $root/issorted.c
build $builddir/_coder_multitaper_spectrogram_coder_api.o : cc $root/interface/_coder_multitaper_spectrogram_coder_api.c
build $builddir/_coder_multitaper_spectrogram_coder_mex.o : cc $root/interface/_coder_multitaper_spectrogram_coder_mex.c
build $builddir/trisolve.o : cc $root/trisolve.c
build $builddir/multitaper_spectrogram_coder_emxutil.o : cc $root/multitaper_spectrogram_coder_emxutil.c
build $builddir/_coder_multitaper_spectrogram_coder_info.o : cc $root/interface/_coder_multitaper_spectrogram_coder_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root\multitaper_spectrogram_coder_mex.mexw64 : link $builddir/multitaper_spectrogram_coder_data.o $builddir/rt_nonfinite.o $builddir/multitaper_spectrogram_coder_initialize.o $builddir/multitaper_spectrogram_coder_terminate.o $builddir/multitaper_spectrogram_coder.o $builddir/colon.o $builddir/eml_int_forloop_overflow_check.o $builddir/nextpow2.o $builddir/combineVectorElements.o $builddir/indexShapeCheck.o $builddir/all.o $builddir/any.o $builddir/detrend.o $builddir/qr.o $builddir/warning.o $builddir/repmat.o $builddir/fft.o $builddir/power.o $builddir/eml_mtimes_helper.o $builddir/mtimes.o $builddir/mean.o $builddir/sum.o $builddir/find.o $builddir/eml_setop.o $builddir/issorted.o $builddir/_coder_multitaper_spectrogram_coder_api.o $builddir/_coder_multitaper_spectrogram_coder_mex.o $builddir/trisolve.o $builddir/multitaper_spectrogram_coder_emxutil.o $builddir/_coder_multitaper_spectrogram_coder_info.o $builddir/c_mexapi_version.o 
